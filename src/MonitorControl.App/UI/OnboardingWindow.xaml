<ui:FluentWindow x:Class="MonitorControl.App.UI.OnboardingWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:loc="clr-namespace:MonitorControl.App.Localization"
                 Title="MonitorControl"
                 Width="560"
                 SizeToContent="Height"
                 ResizeMode="NoResize"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 FlowDirection="{Binding Direction, Source={x:Static loc:Loc.Instance}}">
  <StackPanel>
    <ui:TitleBar Title="MonitorControl" ShowMinimize="False" ShowMaximize="False" />
    <StackPanel Margin="40,8,40,32">
      <Image Source="pack://application:,,,/Assets/AppIcon.png" Width="96" Height="96" HorizontalAlignment="Center" />
      <TextBlock Margin="0,16,0,0" HorizontalAlignment="Center" FontSize="24" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{loc:Tr Onboarding.Welcome}" />
      <TextBlock Margin="0,8,0,0" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                 Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{loc:Tr Onboarding.Description}" />

      <Border Margin="0,24,0,0" Padding="16,12" CornerRadius="8" BorderThickness="1"
              Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
        <StackPanel>
          <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{loc:Tr Onboarding.KeysTitle}" />
          <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{loc:Tr Onboarding.KeysText}" />
        </StackPanel>
      </Border>

      <Border Margin="0,12,0,0" Padding="16,12" CornerRadius="8" BorderThickness="1"
              Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
        <StackPanel>
          <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{loc:Tr Onboarding.StartAtLoginTitle}" />
          <TextBlock Margin="0,4,0,8" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{loc:Tr Onboarding.StartAtLoginText}" />
          <CheckBox x:Name="StartAtLogin" Content="{loc:Tr Onboarding.StartAtLogin}" Click="OnStartAtLoginClick" />
        </StackPanel>
      </Border>

      <ui:Button Margin="0,24,0,0" HorizontalAlignment="Center" Appearance="Primary" Padding="24,8"
                 Content="{loc:Tr Onboarding.Start}" Click="OnStartClick" IsDefault="True" />
    </StackPanel>
  </StackPanel>
</ui:FluentWindow>
