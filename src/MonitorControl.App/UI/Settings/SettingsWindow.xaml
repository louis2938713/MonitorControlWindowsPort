<ui:FluentWindow x:Class="MonitorControl.App.UI.Settings.SettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:loc="clr-namespace:MonitorControl.App.Localization"
                 Title="MonitorControl"
                 Width="960"
                 Height="720"
                 MinWidth="720"
                 MinHeight="480"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 FlowDirection="{Binding Direction, Source={x:Static loc:Loc.Instance}}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <ui:TitleBar x:Name="TitleBar" Title="MonitorControl" ShowMaximize="True" />

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="220" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <ListBox x:Name="Navigation" Margin="8,4,4,8" Background="Transparent" BorderThickness="0" SelectionChanged="OnNavigationChanged">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Orientation="Horizontal" Margin="4,6">
              <TextBlock FontFamily="{StaticResource IconFont}" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center" Text="{Binding Glyph}" />
              <TextBlock VerticalAlignment="Center" Text="{Binding Title}" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <ScrollViewer x:Name="Scroller" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <ContentControl x:Name="PageHost" Margin="24,8,32,24" />
      </ScrollViewer>
    </Grid>
  </Grid>
</ui:FluentWindow>
