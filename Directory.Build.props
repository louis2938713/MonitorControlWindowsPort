<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- Same RIDs everywhere so lock files stay valid for x64 and ARM64 builds. -->
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <Deterministic>true</Deterministic>

    <Product>MonitorControl</Product>
    <Company>MonitorControl</Company>
    <Copyright>Copyright © MonitorControl. @JoniVR, @theOneyouseek, @waydabber and others</Copyright>
    <Version>1.0.0</Version>
    <!-- Increase when the settings format changes; used for settings migration. -->
    <BuildNumber>1</BuildNumber>
  </PropertyGroup>

  <PropertyGroup Condition="'$(CI)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <RestoreLockedMode>true</RestoreLockedMode>
  </PropertyGroup>
</Project>
